        "message": "=Name: {{ $json.name }}\nE-Mail: {{ $json.email }}\nQuelle: {{ $json.quelle }}\n\nNachricht:\n{{ $json.nachricht }}",
        "options": {}
      },
      "id": "gmail1",
      "name": "Interne Benachrichtigung (Gmail)",
      "webhookId": "your-webhook-id",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1200, 0],
