          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "datatable1",
      "name": "Audit-Log schreiben",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [832, 192],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "content": "#  Use-Case & Nodes \n\n### Use Case: Erfassung der Kundenanfragen aus dem Formular. (aktuell simuliert über Formular-Webhook). KI kategorisiert in eine von vier festgelegten Kategorien und leitet sie automatisch per Mail an die zuständige Stelle weiter. Fallback für nicht zugeordnete Informationen. Ersetzt manuelles Sichten/Verteilen von Anfragen.\n\n**1. Formular-Eingang (Webhook-Trigger):** Nimmt POST-Requests entgegen (simuliert das Website-Formular; Ziel: später zusätzlich echter E-Mail-Eingang)\n**2. Normalisieren (Edit Fields):** Vereinheitlicht die eingehenden Felder auf Name, E-mail, Nachricht, Quelle\n**3. Basic LLM Chain + Groq Chat Model:** Schickt die Nachricht an ein Sprachmodell (Groq, openai/gpt-oss-20b). Hier erfolgt Einordnung in die Kategorien: Angebot, Terminanfrage, Reklamation, Sonstiges\n**4. Kategorie zuordnen (Code-Node):** Liest die KI-Antwort aus, fällt bei unerwarteter Antwort auf \"Sonstiges\" zurück (Fallback)\n**5. Zieladresse festlegen(Edit Fields):** Feste Kategorie→E-Mail-Zuordnung (aktuell Platzhalter-Adressen, z.B. angebot@test.de)\n**6. Interne Benachrichtigung (Gmail) :** versendet die Anfrage inkl. Absenderdaten an die zuständige Adresse\n\nVerbindung zu **Error-Handler-Workflow** mit **Error Trigger Node**. Fehler werden bei Zuordnung zu einem Workflow automatisiert über n8n eingetragen. **Nur bei Produktions-Executions aktiv.**  Für den Testfall mit simulierten PIN-Daten getestet.\n\n**Audit-Log(Data Table)** für KI-Einsatz-Dokumentation beim Code-Node ergänzt.\n",
        "height": 336,
        "width": 1472,
        "color": 4
      },
      "id": "sticky1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-64, -400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "k1", "name": "name", "type": "string", "value": "={{ $('Normalisieren').item.json.name }}" },
            { "id": "k2", "name": "email", "type": "string", "value": "={{ $('Normalisieren').item.json.email }}" },
            { "id": "k3", "name": "nachricht", "type": "string", "value": "={{ $('Normalisieren').item.json.nachricht }}" },
            { "id": "k4", "name": "quelle", "type": "string", "value": "={{ $('Normalisieren').item.json.quelle }}" },
            {
              "id": "k5",
              "name": "kategorie",
              "type": "string",
              "value": "={{ ['Angebot','Terminanfrage','Reklamation','Sonstiges'].includes(($json.text ?? $json.output ?? $json.response ?? '').trim()) ? ($json.text ?? $json.output ?? $json.response ?? '').trim() : 'Sonstiges' }}"
            },
            { "id": "k6", "name": "kiRohantwort", "type": "string", "value": "={{ ($json.text ?? $json.output ?? $json.response ?? '').trim() }}" }
          ]
        },
        "options": {}
      },
      "id": "set3",
      "name": "Kategorie zuordnen",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [720, 16]
    }
  ],
