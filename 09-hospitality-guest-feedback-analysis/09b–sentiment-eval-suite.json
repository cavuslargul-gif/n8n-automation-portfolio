    {
      "id": "llmchain1",
      "name": "Sentiment-Klassifikation via OpenAI (Sentiment Classification)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [304, 288],
      "notesInFlow": true,
      "notes": "System-Prompt ist 1:1 aus Workflow 09 kopiert – bei Prompt-Änderungen beide Workflows synchron halten!\n\nPrompt copied 1:1 from workflow 09 — keep both in sync when changing it.",
      "onError": "stopWorkflow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.feedback }}",
        "messages": {
          "messageValues": [
            {
              "message": "=Analysiere das folgende Gästefeedback eines Hotels und antworte ausschließlich im JSON-Format:\n\nFeedback: {{ $json.feedback }}\nGesamtbewertung: {{ $json.bewertung }}/5\n\nBerücksichtige Text UND Gesamtbewertung gemeinsam. Wirkt der Text deutlich positiver oder negativer als die Zahl erwarten lässt (z. B. sehr niedrige Bewertung bei lobendem Text), ist das ein Hinweis auf Sarkasmus oder Ironie — werte das Sentiment dann nach der Bewertung, nicht nach dem Wortlaut.\n\nAntworte nur mit diesem JSON, ohne zusätzlichen Text, ohne Markdown, ohne Backticks, ohne ```json```.:\n{\n  \"sentiment\": \"positiv\" oder \"neutral\" oder \"negativ\",\n  \"themen\": [\"Sauberkeit\", \"Service\", \"Frühstück\", \"Lage\", \"Preis-Leistung\", \"Ironie\", \"Sonstiges\"],\n  \"zusammenfassung\": \"Ein Satz der das Feedback zusammenfasst\"\n}"
            }
          ]
        },
        "batching": { "batchSize": 5, "delayBetweenBatches": 40000 }
      }
    },
    {
      "id": "groqmodel1",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [304, 464],
      "parameters": { "model": "openai/gpt-oss-20b", "options": { "temperature": 0 } },
      "credentials": {
        "groqApi": { "id": "your-groq-credential-id", "name": "Groq account" }
      }
    },
