              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Anfänger"
                  },
                  {
                    "option": "Fortgeschritten"
                  },
                  {
                    "option": "Experte"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
